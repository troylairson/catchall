{
  "name": "family-board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/index.js --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "hono": "^4.13.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.21.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
